{
  "name": "sudeep-kumar-portfolio",
  "version": "2.0.0",
  "private": true,
  "homepage": "https://sudeep-kr-1999.github.io/Portfolio-Sudeep-Kumar",
  "description": "Apple-inspired personal portfolio built with React, Redux Toolkit and Webpack.",
  "scripts": {
    "start": "webpack serve --config webpack.config.js --mode development",
    "dev": "webpack serve --config webpack.config.js --mode development",
    "build": "webpack --config webpack.config.js --mode production",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "deploy": "npm run build && npx --yes gh-pages@3.2.3 -d dist"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.7",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "@babel/preset-react": "^7.24.7",
    "babel-loader": "^9.2.1",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.0",
    "style-loader": "^4.0.0",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0",
    "@babel/preset-typescript": "^7.25.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "@types/webpack-env": "^1.18.5",
    "@types/node": "^22.9.0"
  },
  "packageManager": "yarn@1.22.22"
}
